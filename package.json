{
  "name": "ailover",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI companion for Windows",
  "author": "gift",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts",
    "package": "pnpm build && electron-builder --win nsis && pnpm rebuild better-sqlite3",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.544.0",
    "pino": "^9.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ailover/application": "workspace:*",
    "@ailover/contracts": "workspace:*",
    "@ailover/domain": "workspace:*",
    "@ailover/observability": "workspace:*",
    "@ailover/persistence": "workspace:*",
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
