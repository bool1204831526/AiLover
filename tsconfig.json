{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@ailover/contracts": ["packages/contracts/src/index.ts"],
      "@ailover/backup": ["packages/backup/src/index.ts"],
      "@ailover/cognition": ["packages/cognition/src/index.ts"],
      "@ailover/domain": ["packages/domain/src/index.ts"],
      "@ailover/application": ["packages/application/src/index.ts"],
      "@ailover/memory": ["packages/memory/src/index.ts"],
      "@ailover/model-gateway": ["packages/model-gateway/src/index.ts"],
      "@ailover/observability": ["packages/observability/src/index.ts"],
      "@ailover/persistence": ["packages/persistence/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "*.ts"
  ]
}
